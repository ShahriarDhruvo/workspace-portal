# Template: hostd/install.sh fills the @PLACEHOLDERS@ and installs it as /etc/systemd/system/portal-hostd.service.
[Unit]
Description=Portal host daemon (@ROLE@ role)
Documentation=file:///usr/local/lib/portal-hostd/README.md
Wants=network-online.target
After=network-online.target@AFTER@

[Service]
Type=notify
# Imported, not run as a script: only an import uses the bytecode that install.sh compiled.
ExecStart=/usr/bin/python3 -I -c "import sys,importlib.util as u;s=u.spec_from_file_location('portal_hostd','/usr/local/lib/portal-hostd/portal-hostd.py');m=u.module_from_spec(s);s.loader.exec_module(m);sys.exit(m.main(sys.argv[1:]))"
EnvironmentFile=/etc/portal-hostd/hostd.conf
LoadCredential=token:/etc/portal-hostd/token
@IDENTITY@
Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_PERFMON
CapabilityBoundingSet=CAP_PERFMON
NoNewPrivileges=yes
ProtectSystem=strict
@PROTECT_HOME@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=64M
CPUQuota=20%
TasksMax=32
Nice=10

[Install]
WantedBy=multi-user.target

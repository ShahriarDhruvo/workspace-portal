// Qwen Code system defaults for every workspace (lowest precedence: users may change these in their
// own settings). This is where the models live.
// Upload your own with:  sudo bash deploy/qwen-config.sh install system-defaults.json
// For every entry under modelProviders.openai the portal forces "baseUrl" to its gateway and
// "envKey" to a placeholder (the real key, LLM_API_KEY, never enters a workspace), and removes
// "apiKey". The gateway forwards to LLM_UPSTREAM_URL, so "id" must be a model that server serves.
{
  "$version": 4,
  "security": { "auth": { "selectedType": "openai" } },
  "model": { "name": "qwen3.8-flash-next" },
  "modelProviders": {
    "openai": [
      {
        "id": "qwen3.8-flash-next",
        "name": "Qwen3.8 Flash-Next",
        "description": "Local model through the Workspace Portal",
        "capabilities": {
          "reasoning": { "profile": "openai-effort", "efforts": ["low", "medium", "xhigh"], "defaultEffort": "xhigh" }
        },
        "generationConfig": {
          "timeout": 3600000,
          "streamIdleTimeoutMs": 3600000,
          "streamMaxLifetimeMs": 3600000,
          "maxRetries": 1,
          "contextWindowSize": 262144,
          "modalities": { "image": true },
          "samplingParams": { "temperature": 1, "top_p": 0.95, "presence_penalty": 0, "frequency_penalty": 0, "max_tokens": 32768 },
          "extra_body": { "top_k": 20, "min_p": 0, "repeat_penalty": 1 }
        }
      }
    ]
  }
}

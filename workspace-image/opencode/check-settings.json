{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "model": "portal/models/Check/Check-Model",
  "providers": {
    "portal": {
      "name": "Workspace Portal",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "PORTAL_LLM_KEY"
      ],
      "compatibility": {
        "maxTokensField": "max_tokens"
      },
      "settings": {
        "baseURL": "http://service.invalid:4001/llm/v1",
        "timeout": false,
        "headerTimeout": 3600000,
        "chunkTimeout": 3600000
      },
      "models": {
        "models/Check/Check-Model": {
          "name": "Check model",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "limit": {
            "context": 262144,
            "output": 48000
          },
          "settings": {
            "reasoningEffort": "medium"
          }
        },
        "plain-model": {
          "name": "Plain model",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "portal",
      "effect": "allow"
    },
    {
      "action": "websearch.use",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "websearch": false,
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "search": {
        "type": "remote",
        "url": "http://service.invalid:4001/mcp/search",
        "oauth": false,
        "codemode": false,
        "timeout": {
          "execution": 60000
        }
      },
      "browser": {
        "type": "local",
        "command": [
          "/usr/local/bin/playwright-mcp",
          "--headless",
          "--isolated",
          "--no-sandbox",
          "--executable-path=/usr/bin/chromium",
          "--output-dir=/workspace/.browser"
        ],
        "codemode": false,
        "timeout": {
          "execution": 120000
        }
      }
    }
  }
}

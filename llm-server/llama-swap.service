[Unit]
Description=llama-swap: the LLM, the image model and the media models behind port 8080, started and stopped on demand
Documentation=https://github.com/mostlygeek/llama-swap#readme

[Service]
# Listens on every interface, without a login: the firewall must let only the portal server reach 8080.
# current: the release Admin > Updates switched to, among those side by side in ~/.local/lib/llama-swap.
ExecStart=%h/.local/lib/llama-swap/current/llama-swap -config %h/.config/llama-swap/config.yaml -listen 0.0.0.0:8080
Restart=always
RestartSec=5
# The model units have BindsTo= and After= this unit, so systemd stops them before it, as llama-swap's cmdStop also
# does; the LLM may take 120 s to stop. KillMode=mixed sends the stop signal to llama-swap alone, not to the
# `systemctl start --wait` it runs for each model.
KillMode=mixed
TimeoutStopSec=200

[Install]
WantedBy=default.target

# Where the media servers' compiled kernels, tuning results and downloads persist, so a swap or a reboot neither
# compiles nor downloads them again. Goes to /etc/ai-studio/cache.env; each media unit reads it (EnvironmentFile=)
# and ai-studio-cache.sh exports it to login shells. Gufo keeps its own caches in /models/gufo-cache.
HF_HOME=/var/cache/ai-studio/hf
TORCH_HOME=/var/cache/ai-studio/torch
TRITON_CACHE_DIR=/var/cache/ai-studio/triton
MIOPEN_USER_DB_PATH=/var/cache/ai-studio/miopen
MIOPEN_CUSTOM_CACHE_DIR=/var/cache/ai-studio/miopen
VLLM_CACHE_ROOT=/var/cache/ai-studio/vllm
# ROCm's cache of compiled code objects (Comgr).
AMD_COMGR_CACHE_DIR=/var/cache/ai-studio/comgr
# GEMM tuning, kept per server: each unit names its own file, as a file of another torch build is not read.
PYTORCH_TUNABLEOP_ENABLED=1

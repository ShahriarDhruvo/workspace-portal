[Unit]
Description=Qwen3-TTS 1.7B VoiceDesign, text to speech in a voice described in words; started and stopped by llama-swap
Documentation=https://github.com/gufo-org/gufo/blob/v0.37.0/docs/models/qwen3-tts.md
# Runs beside the LLM; llama-swap starts it on demand and the LLM's group stops it. It stops with llama-swap.
BindsTo=llama-swap.service
After=llama-swap.service

[Container]
ContainerName=gufo-tts-design
Image=ghcr.io/gufo-org/toolboxes/gufo-runtime@sha256:9548e9946c18cab9d135dd5dc2fad47e7bae0285d6240c100bb36a855bb1d4dc
Pull=missing
AddDevice=/dev/kfd
AddDevice=/dev/dri
PublishPort=127.0.0.1:18089:8080
# Gufo's catalog offers only the Base variant: this one is `hf download Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign` at a
# pinned revision into qwen3-tts-voicedesign, beside the weights `gufo model install` downloaded (docs/GUIDE.md).
Volume=/models/gufo-models:/models:ro,z
# Without it podman kills the container 10 s after SIGTERM, whatever TimeoutStopSec says.
StopTimeout=50
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/ready
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/ready
HealthStartupInterval=2s
HealthOnFailure=kill
Notify=healthy
# 8,192 tokens hold the longest input Gufo takes (16 KiB of text, about 3,300 tokens) with its default 3,000 frames
# (240 s) of speech; a request whose prompt plus max_new_tokens does not fit fails with 500. Each 4,096 tokens
# cost 1.3 GiB.
Exec=gufo serve --host 0.0.0.0 --port 8080 tts --model /models/qwen3-tts-voicedesign \
      --served-model-name qwen3-tts-1.7b-design --context 8192

[Service]
# Starts once the GPU memory it needs is free beside the LLM: 7 GiB loaded, about 10 GiB from its first buffered
# WAV of 24 s or more (streamed PCM adds 0.5 GiB).
ExecStartPre=%h/.local/bin/wait-gpu-memory 10
Restart=no
TimeoutStartSec=120
TimeoutStopSec=60

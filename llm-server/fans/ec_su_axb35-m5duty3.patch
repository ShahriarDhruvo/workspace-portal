+/* AXB35 duty registers: 0x80|percent requests manual duty, 0 releases it.
+ * Match the write/read-back protocol in crmaris/FanControl.AXB35.
+ * A ten-second lease prevents a dead userspace controller holding a low duty.
+ * Only the two APU fans are touched. The original level/curve API is separate;
+ * use firmware auto mode and do not run another controller alongside this one.
+ */
+static int write_duty_verified(struct ec_fan *fan, u8 duty)
+{
+    u8 want = duty ? 0x80 | duty : 0, got;
+    int i;
+    for (i = 0; i < 3; i++) {
+        if (!ec_write(fan->duty_reg, want) &&
+            !ec_read(fan->duty_reg, &got) && got == want)
+            return 0;
+        msleep(5);
+    }
+    return -EIO;
+}
+
+static ssize_t fan_duty_show(struct device *dev, struct device_attribute *attr,
+                            char *buf)
+{
+    struct ec_fan *fan = dev_get_drvdata(dev);
+    unsigned int duty;
+    mutex_lock(&duty_lock);
+    duty = fan->duty;
+    mutex_unlock(&duty_lock);
+    return sysfs_emit(buf, "%u\n", duty);
+}
+
+static ssize_t fan_duty_error_show(struct device *dev,
+                                  struct device_attribute *attr, char *buf)
+{
+    struct ec_fan *fan = dev_get_drvdata(dev);
+    int error;
+    mutex_lock(&duty_lock);
+    error = fan->duty_error;
+    mutex_unlock(&duty_lock);
+    return sysfs_emit(buf, "%d\n", error);
+}
+
+static ssize_t fan_duty_raw_show(struct device *dev,
+                                struct device_attribute *attr, char *buf)
+{
+    struct ec_fan *fan = dev_get_drvdata(dev);
+    u8 value;
+    int ret;
+    mutex_lock(&duty_lock);
+    ret = ec_read(fan->duty_reg, &value);
+    mutex_unlock(&duty_lock);
+    return ret ? -EIO : sysfs_emit(buf, "%u\n", value);
+}
+
+static ssize_t fan_duty_store(struct device *dev, struct device_attribute *attr,
+                             const char *buf, size_t count)
+{
+    struct ec_fan *fan = dev_get_drvdata(dev);
+    unsigned int duty;
+    int ret;
+    if (!fan->duty_reg)
+        return -EOPNOTSUPP;
+    if (kstrtouint(buf, 10, &duty) || (duty && (duty < 40 || duty > 95)))
+        return -EINVAL;
+    mutex_lock(&duty_lock);
+    ret = write_duty_verified(fan, duty);
+    fan->duty_error = ret;
+    if (!ret) {
+        fan->duty = duty;
+        fan->release_pending = false;
+        fan->duty_deadline = jiffies + msecs_to_jiffies(10000);
+    } else {
+        fan->duty = 0;
+        fan->release_pending = true;
+        if (!write_duty_verified(fan, 0))
+            fan->release_pending = false;
+    }
+    mutex_unlock(&duty_lock);
+    return ret ? ret : count;
+}
+
+static struct device_attribute dev_attr_fan_duty =
+    __ATTR(duty, 0644, fan_duty_show, fan_duty_store);
+static struct device_attribute dev_attr_fan_duty_error =
+    __ATTR(duty_error, 0444, fan_duty_error_show, NULL);
+static struct device_attribute dev_attr_fan_duty_raw =
+    __ATTR(duty_raw, 0444, fan_duty_raw_show, NULL);

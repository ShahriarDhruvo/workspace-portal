[Unit]
Description=Bosgame M5 fan curve and power profile
# portal-hostd looks for the fans once, when it starts.
Before=portal-hostd.service
# Keeps trying: after a kernel update DKMS may build the module only during the boot.
StartLimitIntervalSec=0

[Service]
ExecStartPre=/usr/sbin/modprobe ec_su_axb35
ExecStartPre=/bin/sh -c 'echo performance > /sys/class/ec_su_axb35/apu/power_mode'
ExecStart=/usr/local/sbin/m5-fans.py
Restart=always
RestartSec=10
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

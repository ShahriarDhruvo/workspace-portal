[Unit]
Description=Qwen3.8 Flash-Next Q4, four 256K sessions; started and stopped by llama-swap
Documentation=https://github.com/gufo-org/gufo/blob/v0.37.0/docs/server.md
# llama-swap starts it on demand and stops it to make room for the image and media models; it stops with llama-swap.
BindsTo=llama-swap.service
After=llama-swap.service

[Container]
ContainerName=gufo
Image=ghcr.io/gufo-org/toolboxes/gufo-runtime@sha256:9548e9946c18cab9d135dd5dc2fad47e7bae0285d6240c100bb36a855bb1d4dc
Pull=missing
AddDevice=/dev/kfd
AddDevice=/dev/dri
# Only llama-swap, on this host, talks to it.
PublishPort=127.0.0.1:18080:8080
Volume=/models/qwen3.8-flash-next:/models:ro,z
# The prompt cache's disk tier, so conversations survive a restart; owned by the container's user (uid 1000).
Volume=/models/gufo-cache/disk:/cache:Z
# With the disk tier on, Gufo hashes the model files at start and keeps the result here, so a restart skips it.
Volume=/models/gufo-cache/home:/home/gufo/.cache:Z
# Time to finish the cache writes already queued after SIGTERM; podman's own default is 10 s.
StopTimeout=120
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/ready
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/ready
HealthStartupInterval=2s
HealthOnFailure=kill
Notify=healthy
Exec=gufo serve --host 0.0.0.0 --port 8080 --sessions 4 --max-connections 64 --max-request-bytes 67108864 llm \
      --model /models/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf \
      --mmproj /models/mmproj-BF16.gguf \
      --speculative mtp \
      --mtp-model /models/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf \
      --context 262144 \
      --max-tokens 64000 \
      --reasoning-budget 32000 \
      --served-model-name qwen3.8-flash-next \
      --cache-ram-bytes 4294967296 \
      --cache-disk /cache \
      --cache-disk-bytes 34359738368 \
      --max-pending 32 \
      --stall-timeout-ms 600000 \
      --log-progress

[Service]
# Starts only once the image or media model llama-swap stopped has let go of the GPU memory it needs.
ExecStartPre=%h/.local/bin/wait-gpu-memory 90
# llama-swap starts it again with the next request; systemd must not start it behind llama-swap's back.
Restart=no
TimeoutStartSec=600
TimeoutStopSec=150

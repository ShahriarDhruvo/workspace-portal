[Unit]
Description=Qwen3.8 Flash-Next Q4, seven 128K sessions (only service on this host)
Documentation=https://github.com/gufo-org/gufo/blob/v0.35.0/docs/SERVER.md

[Container]
ContainerName=gufo
Image=ghcr.io/gufo-org/toolboxes/gufo-runtime@sha256:99e9b5471b7a9b007c686c2aa795afaf966744d64e753cb009c89541f9e9c2b6
Pull=missing
AddDevice=/dev/kfd
AddDevice=/dev/dri
# Listens on every interface; the firewall only lets the portal server reach 8080.
PublishPort=8080:8080
Volume=/models/qwen3.8-flash-next:/models:ro,z
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/ready
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/ready
HealthStartupInterval=2s
HealthOnFailure=kill
Notify=healthy
Exec=gufo serve --host 0.0.0.0 --port 8080 --sessions 7 --max-connections 64 --max-request-bytes 67108864 llm \
      --model /models/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf \
      --mmproj /models/mmproj-BF16.gguf \
      --speculative mtp \
      --mtp-model /models/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf \
      --context 131072 \
      --max-tokens 32768 \
      --served-model-name qwen3.8-flash-next \
      --cache-ram-bytes 4294967296 \
      --max-pending 32 \
      --stall-timeout-ms 600000 \
      --log-progress

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=600
TimeoutStopSec=30

[Install]
WantedBy=default.target

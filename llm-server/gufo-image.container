[Unit]
Description=Qwen-Image-2.1, text to image and image editing; started and stopped by llama-swap
Documentation=https://github.com/gufo-org/gufo/blob/v0.37.0/docs/models/qwen-image-2.1.md
BindsTo=llama-swap.service
After=llama-swap.service

[Container]
ContainerName=gufo-image
Image=ghcr.io/gufo-org/toolboxes/gufo-runtime@sha256:9548e9946c18cab9d135dd5dc2fad47e7bae0285d6240c100bb36a855bb1d4dc
Pull=missing
AddDevice=/dev/kfd
AddDevice=/dev/dri
PublishPort=127.0.0.1:18081:8080
# The weights `gufo model install` downloaded (docs/GUIDE.md), named by their model id.
Volume=/models/gufo-models:/models:ro,z
Environment=GUFO_MODELS_DIR=/models
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/ready
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/ready
HealthStartupInterval=2s
HealthOnFailure=kill
Notify=healthy
Exec=gufo serve --host 0.0.0.0 --port 8080 image --model qwen-image-2.1 --served-model-name Qwen-Image-2.1

[Service]
# Starts only once the LLM has let go of its GPU memory.
ExecStartPre=%h/.local/bin/wait-gpu-memory 40
Restart=no
TimeoutStartSec=300
TimeoutStopSec=60

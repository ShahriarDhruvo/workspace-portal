{
  "name": "@portal/gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@portal/container": "0.1.0",
    "@portal/core": "0.1.0",
    "@portal/harnesses": "0.1.0",
    "better-sqlite3": "13.2.0",
    "dockerode": "5.0.1",
    "drizzle-orm": "0.45.4",
    "ws": "8.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/dockerode": "4.0.2",
    "@types/node": "26.6.11",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}

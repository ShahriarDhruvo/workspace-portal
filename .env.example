# Workspace Portal configuration. Copy to .env (deploy/install.sh does this and fills in the secrets).
# Quote values that contain spaces.

# --- Paths and ports -------------------------------------------------------
PORTAL_DATA_DIR=/srv/workspace-portal
WEB_BIND=0.0.0.0
WEB_PORT=3000
# Each user's workspace (the Qwen Code Web Shell) is served on its own port, AGENT_PORT_BASE + user id,
# so every workspace is a separate browser origin. Users 1 … AGENT_PORT_COUNT-1 fit in the range
# (3101-3299 by default); the installer opens it in the host firewall.
AGENT_BIND=0.0.0.0
AGENT_PORT_BASE=3100
AGENT_PORT_COUNT=200
# Local only: the web app talks to the gateway here.
CONTROL_PORT=4002
# Where workspaces reach the gateway (model + web search), on WORKSPACE_GATEWAY_IP only.
# The host firewall is generated from this and the WORKSPACE_* network settings: after changing
# any of them, re-run sudo bash deploy/install.sh.
SERVICE_PORT=4001
# Who may reach the portal and the workspace ports, as space-separated addresses or CIDRs, e.g.
# "100.64.0.0/10" for Tailscale only. Empty: the LAN of the default route, plus 100.64.0.0/10 when
# a tailscale0 interface exists. Applied by deploy/install.sh when firewalld or ufw is active.
FIREWALL_ALLOW_SOURCE=

# --- Secrets (install.sh generates these) -----------------------------------
# Shared by the web app and the gateway; both refuse to start without one of at least 16 characters.
GATEWAY_CONTROL_SECRET=

# --- Sessions ---------------------------------------------------------------
# Set to true when the portal is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# --- The single admin account (created on first start if no admin exists) ----
# ADMIN_PASSWORD is the first sign-in password only: the portal then asks the admin to choose a new one.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Portal
ADMIN_MIDDLE_NAME=
ADMIN_LAST_NAME=Admin

# --- Model provider (any OpenAI-compatible server: llama.cpp, vLLM, Ollama, a hosted API) ---
# The gateway is the only way workspaces reach it. Give the URL *without* /v1 when the server serves
# /v1/chat/completions (llama.cpp, vLLM); the gateway forwards /v1/... paths unchanged.
LLM_UPSTREAM_URL=http://127.0.0.1:8080
# Sent as "Authorization: Bearer <key>" to the provider. Never enters a workspace.
LLM_API_KEY=
# The models users can pick, in both agents, are defined in Qwen Code's system-defaults.json (see
# README: "Connect the model"), installed with deploy/qwen-config.sh.
# Match the number of parallel slots on the LLM server.
LLM_MAX_CONCURRENCY=3
LLM_MAX_CONCURRENCY_PER_USER=2

# --- Search provider (SearXNG) -----------------------------------------------
# Base URL of your SearXNG instance as the gateway reaches it. Its settings.yml must allow the JSON
# output format (search.formats: [html, json]). Workspaces never talk to it directly.
SEARXNG_URL=http://127.0.0.1:8888
# Optional Authorization header value for an instance behind auth, e.g. "Basic dXNlcjpwYXNz".
SEARXNG_AUTHORIZATION=
SEARXNG_TIMEOUT_SECONDS=20
SEARCH_MAX_CONCURRENT_PER_USER=2
# Engines asked by name, once more, when a search comes back with fewer than SEARCH_FALLBACK_BELOW
# results. They can be engines your SearXNG loads but keeps out of ordinary searches
# (disabled: true in its settings.yml), so they are only used when the main ones find little.
# Comma-separated SearXNG engine names; empty: no second try.
SEARCH_FALLBACK_ENGINES=
SEARCH_FALLBACK_BELOW=3
# The same search within this many minutes is answered from memory (0 = always ask again).
SEARCH_CACHE_MINUTES=15

# --- Page reader (the read_page tool) ---------------------------------------
# The reader container fetches one public web page or PDF for an agent and returns its text. It is
# the only part of the stack that connects to addresses an agent names, so it runs on a network of
# its own that can reach the public internet and nothing else (see docs/ARCHITECTURE.md).
# The gateway reaches it at http://127.0.0.1:READER_PORT. READER_URL=off gives agents web_search only.
#READER_URL=off
# Which pages an agent may open:
#   shown  a URL from its search results, from a page it read or from its conversation (what you
#          typed, what its tools printed), plus everything on READER_TRUSTED_HOSTS. A URL the model
#          put together itself is refused: that is how a poisoned page gets an agent to send your
#          files to someone else's server.
#   any    every public page.
READER_URL_POLICY=shown
# Sites that may be read without having been shown, subdomains included. Comma-separated host names;
# none = no such site. Not set: a built-in list of documentation and code sites
# (DEFAULT_TRUSTED_HOSTS in gateway/src/config.ts).
#READER_TRUSTED_HOSTS=github.com,docs.python.org
# Characters of a page handed to the model per call; it asks for the next part when it needs more.
READER_PAGE_CHARS=20000
# A page stays in memory this long, so reading on through it does not download it again.
READER_CACHE_MINUTES=15
READER_TIMEOUT_SECONDS=60
READER_MAX_CONCURRENT_PER_USER=2
# The reader's own limits: seconds per page, pages fetched at once, download sizes.
READER_FETCH_TIMEOUT_SECONDS=20
READER_MAX_CONCURRENT=2
READER_MAX_DOWNLOAD_MB=5
READER_MAX_PDF_MB=15
READER_MAX_PDF_PAGES=60
# What the reader calls itself to the sites it visits.
#READER_USER_AGENT=
# The reader's network. Its DNS servers must be public ones: the firewall lets the reader reach no
# private address, your router included.
READER_PORT=4003
READER_SUBNET=172.30.250.0/28
READER_BRIDGE=br-wreader
READER_DNS_1=1.1.1.1
READER_DNS_2=9.9.9.9

# --- Workspaces -------------------------------------------------------------
# The agents a user can choose from when their workspace starts (one runs at a time), comma-separated:
# qwen (Qwen Code) and dsh (DeepSeek Harness). With just one, it starts without asking.
WORKSPACE_AGENTS=qwen,dsh
# The agent versions in the workspace images, which are tagged workspace-portal/workspace:<agent>-<version>.
# Change them with deploy/update-image.sh (see README: "Updating the workspace images").
QWEN_CODE_VERSION=0.27.0
DSH_VERSION=0.2.2-rc.1
# Internal Docker network (no route off the host), created by the gateway.
WORKSPACE_NETWORK=workspace-portal-ws
WORKSPACE_SUBNET=172.29.0.0/16
WORKSPACE_GATEWAY_IP=172.29.0.1
WORKSPACE_IP_RANGE=172.29.128.0/17
# Linux bridge name for the workspace network (the host firewall rules match on it).
WORKSPACE_BRIDGE=br-wportal
# User N's workspace runs as UID/GID WORKSPACE_UID_BASE + N, which owns only that user's files.
WORKSPACE_UID_BASE=200000
WORKSPACE_MEMORY=3g
WORKSPACE_CPUS=4
WORKSPACE_PIDS=1024
WORKSPACE_SHM=1g
# In-memory /tmp (the rest of the root filesystem is read-only).
WORKSPACE_TMP=1g
# Offer the headless Chromium browser tool (it can only open pages served inside the workspace).
WORKSPACE_BROWSER=true
MAX_RUNNING_WORKSPACES=4
# A workspace stops after this long without use, but never while its agent is working.
IDLE_TIMEOUT_MINUTES=30
# Safety net for stuck agents: work stops counting this many hours after a person last did anything
# in the workspace. 0 = no limit.
MAX_BUSY_HOURS=24
UPLOAD_LIMIT_MB=100

# Workspace Portal configuration. Copy to .env (deploy/install.sh does this and fills in the secrets).
# Quote values that contain spaces.

# --- Paths and ports -------------------------------------------------------
PORTAL_DATA_DIR=/srv/workspace-portal
WEB_BIND=0.0.0.0
WEB_PORT=3000
# Each user's workspace (the Qwen Code Web Shell) is served on its own port, AGENT_PORT_BASE + user id,
# so every workspace is a separate browser origin. Users 1 … AGENT_PORT_COUNT-1 fit in the range
# (3101-3299 by default); the installer opens it in the host firewall.
AGENT_BIND=0.0.0.0
AGENT_PORT_BASE=3100
AGENT_PORT_COUNT=200
# Local only: the web app talks to the gateway here.
CONTROL_PORT=4002
# Where workspaces reach the gateway (model + web search), on WORKSPACE_GATEWAY_IP only.
SERVICE_PORT=4001

# --- Secrets (install.sh generates these) -----------------------------------
GATEWAY_CONTROL_SECRET=

# --- Sessions ---------------------------------------------------------------
# Set to true when the portal is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# --- The single admin account (created on first start if no admin exists) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Portal
ADMIN_MIDDLE_NAME=
ADMIN_LAST_NAME=Admin

# --- Model provider (any OpenAI-compatible server: llama.cpp, vLLM, Ollama, a hosted API) ---
# The gateway is the only way workspaces reach it. Give the URL *without* /v1 when the server serves
# /v1/chat/completions (llama.cpp, vLLM); the gateway forwards /v1/... paths unchanged.
LLM_UPSTREAM_URL=http://127.0.0.1:8080
# Sent as "Authorization: Bearer <key>" to the provider. Never enters a workspace.
LLM_API_KEY=
# The default model offered in Qwen Code, used unless config/qwen/system-defaults.json defines models.
LLM_MODEL_ID=qwen3.8-flash-next
LLM_MODEL_NAME="Qwen3.8 Flash-Next"
LLM_CONTEXT_WINDOW=262144
LLM_MAX_TOKENS=32768
# Comma-separated: text or text,image
LLM_INPUT=text,image
# true if the server understands reasoning_effort (a thinking model).
LLM_REASONING=true
# Match the number of parallel slots on the LLM server.
LLM_MAX_CONCURRENCY=3
LLM_MAX_CONCURRENCY_PER_USER=2

# --- Search provider (SearXNG) -----------------------------------------------
# Base URL of your SearXNG instance as the gateway reaches it. Its settings.yml must allow the JSON
# output format (search.formats: [html, json]). Workspaces never talk to it directly.
SEARXNG_URL=http://127.0.0.1:8888
# Optional Authorization header value for an instance behind auth, e.g. "Basic dXNlcjpwYXNz".
SEARXNG_AUTHORIZATION=
SEARXNG_TIMEOUT_SECONDS=20
SEARCH_MAX_CONCURRENT_PER_USER=2

# --- Workspaces -------------------------------------------------------------
# Built from workspace-image/ by deploy/install.sh (see README: "Updating the workspace image").
WORKSPACE_IMAGE=workspace-portal/workspace:qwen-0.27.0
# Internal Docker network (no route off the host), created by the gateway.
WORKSPACE_NETWORK=workspace-portal-ws
WORKSPACE_SUBNET=172.29.0.0/16
WORKSPACE_GATEWAY_IP=172.29.0.1
WORKSPACE_IP_RANGE=172.29.128.0/17
# Linux bridge name for the workspace network (the host firewall rules match on it).
WORKSPACE_BRIDGE=br-wportal
# User N's workspace runs as UID/GID WORKSPACE_UID_BASE + N, which owns only that user's files.
WORKSPACE_UID_BASE=200000
WORKSPACE_MEMORY=3g
WORKSPACE_CPUS=4
WORKSPACE_PIDS=1024
WORKSPACE_SHM=1g
# In-memory /tmp (the rest of the root filesystem is read-only).
WORKSPACE_TMP=1g
# Offer the headless Chromium browser tool (it can only open pages served inside the workspace).
WORKSPACE_BROWSER=true
MAX_RUNNING_WORKSPACES=4
# A workspace stops after this long without use, but never while its agent is working.
IDLE_TIMEOUT_MINUTES=30
# Safety net for stuck agents: work stops counting this many hours after a person last did anything
# in the workspace. 0 = no limit.
MAX_BUSY_HOURS=24
UPLOAD_LIMIT_MB=100

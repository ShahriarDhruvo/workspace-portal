# Workspace Portal settings and their defaults. deploy/install.sh copies this file to .env, generates the secrets
# and adds any setting .env lacks. Quote values that contain spaces.
# Needs the installer again: PORTAL_DATA_DIR, HOSTD_PORTAL_*, FIREWALL_*, WORKSPACE_AGENTS, an agent's *_VERSION,
# a port, subnet, *_GATEWAY_IP, bridge, DNS server or the server in a *_URL. Anything else: docker compose up -d.

# --- Paths and ports
PORTAL_DATA_DIR=/srv/workspace-portal
WEB_BIND=0.0.0.0
WEB_PORT=3000
# true: browsers reach the portal over HTTPS, on port 443, and each workspace on its own port; the session cookie
# then never travels over HTTP. deploy/tailscale-https.sh sets it, with WEB_BIND and AGENT_BIND.
PORTAL_HTTPS=false
# User N's workspace is served on AGENT_PORT_BASE + N (Private) and ONLINE_AGENT_PORT_BASE + N (Online), for
# N < AGENT_PORT_COUNT; the apps running in it 1000 ports higher: 3101-3299, 3301-3499, 4101-4299, 4301-4499.
AGENT_BIND=0.0.0.0
AGENT_PORT_BASE=3100
AGENT_PORT_COUNT=200
# Empty: AGENT_PORT_BASE + AGENT_PORT_COUNT.
ONLINE_AGENT_PORT_BASE=
# The gateway's control API on 127.0.0.1, for the web app.
CONTROL_PORT=4002
# The gateway's port for workspaces (model, web search), on WORKSPACE_GATEWAY_IP and ONLINE_GATEWAY_IP only.
SERVICE_PORT=4001
# Who may reach the portal and workspace ports (firewalld), as space-separated addresses or CIDRs.
# Empty: the LAN of the default route, and 100.64.0.0/10 when tailscale0 exists. Behind deploy/tailscale-https.sh
# it does not apply: the tailnet's access rules decide.
FIREWALL_ALLOW_SOURCE=
# More addresses or CIDRs the Online workspaces, the reader and SearXNG must never reach. They never reach a private
# address, this host's networks and router, or the servers the *_URL settings name (as resolved by the installer).
FIREWALL_NEVER_REACH=
# IANA zone in which a day of usage and energy begins. Empty: the installer records the host's.
TZ=

# --- Secrets and sign-in
# Generated by the installer; shared by the web app and the gateway.
GATEWAY_CONTROL_SECRET=
SESSION_TTL_HOURS=168
# The admin account, created at first start. The generated ADMIN_PASSWORD is for the first sign-in only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Portal
ADMIN_MIDDLE_NAME=
ADMIN_LAST_NAME=Admin

# --- Model server (OpenAI-compatible)
# Without /v1.
LLM_UPSTREAM_URL=http://127.0.0.1:8080
# Sent as "Authorization: Bearer <key>"; never enters a workspace.
LLM_API_KEY=
# The model server's parallel slots.
LLM_MAX_CONCURRENCY=3
LLM_MAX_CONCURRENCY_PER_USER=2

# --- portal-hostd: server readings and LLM engine updates (hostd/README.md)
# This server's: installed by the installer, which generates the token. off: none.
HOSTD_PORTAL_URL=http://127.0.0.1:9180
HOSTD_PORTAL_TOKEN=
# The LLM server's: both values are printed by hostd/install.sh llm there.
HOSTD_LLM_URL=
HOSTD_LLM_TOKEN=
# GitHub repository with the engine's release notes, or none.
ENGINE_RELEASE_NOTES_REPO=gufo-org/gufo
# An engine update waits this long for running LLM requests before it restarts the engine.
ENGINE_DRAIN_MINUTES=15

# --- Web search (web_search)
# The stack's own SearXNG, on 127.0.0.1; the installer generates its key.
SEARXNG_PORT=8888
SEARXNG_SECRET=
# Another SearXNG instead (its settings must allow format=json), and its Authorization header if it wants one.
#SEARXNG_URL=http://search.example.lan:8888
SEARXNG_AUTHORIZATION=
SEARXNG_TIMEOUT_SECONDS=20
SEARCH_MAX_CONCURRENT_PER_USER=2
# SearXNG engines asked once more when a search finds fewer than SEARCH_FALLBACK_BELOW results. none: no second try.
SEARCH_FALLBACK_ENGINES=duckduckgo,swisscows,privacywall,mojeek
SEARCH_FALLBACK_BELOW=3
# 0: never answer a repeated search from memory.
SEARCH_CACHE_MINUTES=15
# on: Exa (exa.ai), a search service made for AI agents, is asked first, without an account or a key, at a limit Exa
# does not publish. Each search it can answer (the first page, with no time range and no language) then leaves this
# server for Exa; SearXNG answers the others, and every search while Exa refuses or fails. off: only SearXNG is asked.
EXA_SEARCH=off
# The DNS servers must be public: the firewall lets SearXNG reach no private address.
SEARXNG_SUBNET=172.30.250.16/28
SEARXNG_BRIDGE=br-wsearxng
SEARXNG_DNS_1=1.1.1.1
SEARXNG_DNS_2=9.9.9.9

# --- Page reader (read_page)
# off: no read_page tool.
#READER_URL=off
# shown: an agent may open the URLs it was shown (search results, pages it read, its conversation) and the trusted
# hosts; a URL the model made up is refused. any: every public page.
READER_URL_POLICY=shown
# Hosts readable without having been shown, subdomains included. none: no host. Unset: DEFAULT_TRUSTED_HOSTS in
# gateway/src/config.ts.
#READER_TRUSTED_HOSTS=github.com,docs.python.org
# Characters of a page per read_page call.
READER_PAGE_CHARS=20000
READER_CACHE_MINUTES=15
# How long the gateway waits for the reader.
READER_TIMEOUT_SECONDS=60
READER_MAX_CONCURRENT_PER_USER=2
# The reader's own limits.
READER_FETCH_TIMEOUT_SECONDS=20
READER_MAX_CONCURRENT=2
READER_MAX_DOWNLOAD_MB=5
READER_MAX_PDF_MB=15
READER_MAX_PDF_PAGES=60
#READER_USER_AGENT=
# The DNS servers must be public: the firewall lets the reader reach no private address.
READER_PORT=4003
READER_SUBNET=172.30.250.0/28
READER_BRIDGE=br-wreader
READER_DNS_1=1.1.1.1
READER_DNS_2=9.9.9.9

# --- Workspaces
# The agents users choose from, the default first: qwen (Qwen Code), dsh (DeepSeek Harness), opencode (OpenCode).
WORKSPACE_AGENTS=qwen,dsh,opencode
# What a fresh install builds. Admin > Updates and deploy/update-image.sh change the version in use.
QWEN_CODE_VERSION=0.27.0
DSH_VERSION=0.2.2-rc.1
OPENCODE_VERSION=2.4.1
# Private workspaces: a Docker network without a route off the host.
WORKSPACE_NETWORK=workspace-portal-ws
WORKSPACE_SUBNET=172.29.0.0/16
WORKSPACE_GATEWAY_IP=172.29.0.1
WORKSPACE_IP_RANGE=172.29.128.0/17
WORKSPACE_BRIDGE=br-wportal
# User N's Private workspace runs as UID and GID WORKSPACE_UID_BASE + N.
WORKSPACE_UID_BASE=200000
# Online workspaces: the public internet over TCP, nothing else. off: nobody has one.
ONLINE_WORKSPACES=on
ONLINE_NETWORK=workspace-portal-online
ONLINE_SUBNET=172.28.0.0/16
ONLINE_GATEWAY_IP=172.28.0.1
ONLINE_IP_RANGE=172.28.128.0/17
ONLINE_BRIDGE=br-wonline
# The only DNS servers an Online workspace reaches; they must be public.
ONLINE_DNS_1=1.1.1.1
ONLINE_DNS_2=9.9.9.9
# At least AGENT_PORT_COUNT away from WORKSPACE_UID_BASE, and outside every range in /etc/subuid and /etc/subgid.
ONLINE_UID_BASE=2000000000

# --- Workspace limits (both kinds)
WORKSPACE_MEMORY=3g
WORKSPACE_CPUS=4
WORKSPACE_PIDS=1024
WORKSPACE_SHM=1g
# The in-memory /tmp.
WORKSPACE_TMP=1g
# The headless Chromium tool.
WORKSPACE_BROWSER=true
# What a new agent session starts with: none, low, medium, high, xhigh, max, or model (each model's defaultEffort).
DEFAULT_REASONING_EFFORT=low
MAX_RUNNING_WORKSPACES=4
# An unused workspace stops after this long, never while its agent is working.
IDLE_TIMEOUT_MINUTES=30
# A working agent keeps its workspace up at most this long after a person last used it. 0: no limit.
MAX_BUSY_HOURS=24
# The largest file a person can upload into a workspace. The Web Shell writes it to disk as it arrives.
UPLOAD_LIMIT_MB=10240

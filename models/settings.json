// Qwen Code's system settings in every workspace: users can't override them. Any Qwen Code setting may go here.
// Install your own:  sudo bash deploy/models.sh install settings.json
// On top of this file the portal sets the "search" MCP server and, with WORKSPACE_BROWSER, the "browser" one
// (headless Chromium in the workspace); turns off auto-update, usage statistics, telemetry and the model-catalog
// refresh; denies web_fetch and removes the built-in web search providers; and sets its own OpenAI-compatible auth.
{
  "$version": 4,
  "general": {
    "enableAutoUpdate": false
  },
  "permissions": {
    "deny": ["web_fetch"]
  }
}
